{
  "name": "cortex-server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "server": "nodemon ./server/index.js",
    "start": "node ./server/index.js",
    "web": "npm run dev --prefix web",
    "web-build": "npm run build --prefix web",
    "web-install": "npm install --prefix web",
    "lint": "eslint . --ext js --ignore-pattern web --ignore-pattern node_modules --report-unused-disable-directives --max-warnings 0"
  },
  "dependencies": {
    "axios": "^1.6.7",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "redis": "^4.6.13",
    "shpjs": "^6.2.0"
  },
  "devDependencies": {
    "eslint": "^8.56.0",
    "nodemon": "^3.1.0"
  }
}
